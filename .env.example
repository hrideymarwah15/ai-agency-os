# AI Agency OS - Environment Configuration
# Copy this to .env and fill in your credentials

# ============================================
# AGENCY IDENTITY
# ============================================
AGENCY_NAME="Nexus AI Agency"
AGENCY_OWNER_EMAIL="owner@example.com"
AGENCY_OWNER_NAME="Agency Owner"
AGENCY_PHONE="+91-9876543210"
AGENCY_ADDRESS="Mumbai, India"  # required (CMP-04 physical address)
DEFAULT_CURRENCY="INR"

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://localhost:5432/ai_agency_os"
# Supabase (managed Postgres):
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_KEY="your-anon-key"
# SUPABASE_SERVICE_KEY="your-service-role-key"

# ============================================
# AI MODEL PROVIDERS (Free tiers available)
# ============================================
OPENROUTER_API_KEY="sk-or-v1-xxxxx"
GROQ_API_KEY="gsk_xxxxx"
GEMINI_API_KEY="your-gemini-key"
OLLAMA_BASE_URL="http://localhost:11434"

# Default model for different tasks
MODEL_LEAD_HUNTER="openrouter/auto"
MODEL_AUDITOR="groq/llama3-70b-8192"
MODEL_SALES="openrouter/anthropic/claude-3.5-sonnet"
MODEL_NEGOTIATOR="openrouter/anthropic/claude-3.5-sonnet"
MODEL_DEVELOPER="openrouter/deepseek/deepseek-coder"
MODEL_LEGAL="openrouter/anthropic/claude-3.5-sonnet"

# ============================================
# SEARCH & SCRAPING
# ============================================
GOOGLE_SEARCH_API_KEY=""
GOOGLE_CSE_ID=""
SERPAPI_KEY=""

# ============================================
# EMAIL & COMMUNICATIONS
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# WhatsApp Business (Meta Cloud API)
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# ============================================
# DEPLOYMENT TARGETS
# ============================================
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
NETLIFY_AUTH_TOKEN=""

# ============================================
# MONITORING & ANALYTICS
# ============================================
SENTRY_DSN=""
GOOGLE_ANALYTICS_ID=""

# ============================================
# AGENCY GUARDRAILS (Pricing Rules)
# ============================================
MIN_WEBSITE_STARTER=10000
MIN_WEBSITE_BUSINESS=25000
MIN_WEBSITE_PREMIUM=50000
MIN_AUTOMATION_BASIC=15000
MIN_AUTOMATION_MEDIUM=40000
MIN_AUTOMATION_ADVANCED=80000
MIN_AI_CHATBOT_SETUP=20000
MAX_DISCOUNT_PERCENTAGE=15
AUTO_APPROVE_THRESHOLD=50000

# ============================================
# BUDGET CAPS (FND-06 — per-provider daily USD caps)
# ============================================
LLM_DAILY_BUDGET_USD_OPENROUTER=5.0
LLM_DAILY_BUDGET_USD_GROQ=5.0
LLM_DAILY_BUDGET_USD_GEMINI=5.0
LLM_COST_USD_PER_1K_TOKENS='{"openrouter": "0.50", "groq": "0.10", "gemini": "0.25"}'

# ============================================
# COMPLIANCE (CMP-01..04)
# ============================================
CRAWLER_USER_AGENT="AIAgencyOS/1.0 (+contact via settings)"
ROBOTS_CACHE_TTL_SECONDS=3600
RATE_LIMIT_CAPACITY=1.0
RATE_LIMIT_REFILL_PER_SEC=0.33

# ============================================
# WEBSITE AUDITS (AUDT-01..04 — D-35/D-45)
# ============================================
AUDIT_VERSION=1.0
AUDIT_BROKEN_LINK_SAMPLE=20          # internal links checked per page (D-45)
AUDIT_EXTERNAL_LINK_CAP=5            # external links checked per audit; 0 = off (D-45)
AUDIT_HTML_MAX_BYTES=524288          # hard cap on HTML read (CMP-06)
AUDIT_MAX_RENDER_SECONDS=60          # Playwright render timeout gate (D-33)

# ============================================
# OWNER AUTH (D-16 — generate hash via scripts/hash_password.py)
# ============================================
SESSION_SECRET="change-me-to-a-random-string"
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false  # true behind HTTPS
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD_HASH="$argon2id$v=19$m=65536,t=3,p=4$..."

# ============================================
# MOCK MODE (D-20 — dev-only mock agent data, default off)
# ============================================
MOCK_MODE=false

# ============================================
# DISCOVERY SOURCES (D-21 — unconfigured sources are disabled)
# ============================================
# Hacker News Algolia API (keyless, 10k req/hr/IP) — the only live source by default.
SOURCE_HN_ENABLED=true
# Reddit is live-EXCLUDED (LEAD-04: robots deny + 403 since May 2026); never enabled.
SOURCE_REDDIT_ENABLED=false
# Yelp Fusion / Google Places are key-gated (ToS: no >24h caching / no AI training).
SOURCE_YELP_ENABLED=false
SOURCE_GOOGLE_PLACES_ENABLED=false
# Mock-only directory source for demos/tests.
SOURCE_MOCK_DIRECTORY_ENABLED=false
# Per-source candidate cap per run.
DISCOVERY_MAX_ITEMS_PER_SOURCE=50
YELP_API_KEY=""
GOOGLE_PLACES_API_KEY=""

# ============================================
# REDIS / QUEUE
# ============================================
REDIS_URL="redis://localhost:6379/0"

# ============================================
# SCHEDULER SETTINGS
# ============================================
DAILY_LEAD_DISCOVERY_COUNT=10
DAILY_OUTREACH_LIMIT=25
AUDIT_BATCH_SIZE=5
MAINTENANCE_CHECK_HOUR=3
