<section class="proposal-section" id="pricing"><h2>Pricing</h2><p><strong>{{ pricing.package_name }}</strong></p><table><tr><th>Item</th><th>Amount</th></tr>{% for item in pricing.line_items %}<tr><td>{{ item.name }}</td><td>{{ item.amount }}</td></tr>{% endfor %}</table><p class="price">{{ pricing.recommended_price }}</p><p>Margin: {{ pricing.profit_margin_pct }}% · Maximum discount: {{ pricing.max_discount_pct }}%</p></section>
