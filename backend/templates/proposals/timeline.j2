<section class="proposal-section" id="timeline"><h2>Timeline</h2><table><tr><th>Phase</th><th>Duration</th><th>Dependencies</th></tr>{% for phase in timeline.phases %}<tr><td>{{ phase.name }}</td><td>{{ phase.weeks }} weeks</td><td>{{ phase.dependencies | default([]) | join(', ') }}</td></tr>{% endfor %}</table><p>Buffer: {{ timeline.buffer_weeks }} weeks · Total: {{ timeline.total_weeks }} weeks</p></section>
